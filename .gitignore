# --- Bulk data & the canonical store (SPECS: data/ is gitignored) ------------
# Everything under data/ is generated or downloaded and must never be committed
# (OAI/IIIF caches, images, models, GT, data/inventory.sqlite). Only the two
# committed markers below survive — see data/README.md.
data/*
!data/.gitkeep
!data/README.md

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Local scratch (session temp; the canonical scratchpad is outside the repo) -
scratchpad/

# --- Deployment (deploy/install.sh keeps uv's cache + interpreter under the checkout) -
.uv/

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/

# --- OS / editor -------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
