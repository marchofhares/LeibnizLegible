# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.
# Everything in the pipeline runs WITHOUT any of these; LLM steps skip
# gracefully when ANTHROPIC_API_KEY is absent (SPECS/COMMON CONTEXT).

# Optional. Enables the LLM passes: benchmark VLM adapter, reading-text
# extraction QA, bounded correction subsets. Leave blank to skip them.
ANTHROPIC_API_KEY=

# Contact email embedded in the crawler User-Agent (SPECS §7.4 politeness).
# Used when harvesting OAI-PMH / IIIF / the BBAW katalog.
LEIBNIZ_CONTACT_EMAIL=you@example.org

# User-Agent string for all outbound crawling. MUST identify the project and a
# contact. Keep the contact in sync with LEIBNIZ_CONTACT_EMAIL.
LEIBNIZ_USER_AGENT=leibniz-legible/0.1 (+https://github.com/marchofhares/leibnizlegible; mailto:you@example.org)

# Path to the canonical SQLite store. Defaults to data/inventory.sqlite.
LEIBNIZ_DB_PATH=data/inventory.sqlite

# --- Serving (Phase D1/D2) ---------------------------------------------------
# Every `leibniz serve` option has a variable (deploy/env.example is the
# production version of this block; deploy/README.md the runbook).
# Search backend for `leibniz serve`: fts5 (a single file, the dev fallback),
# meili (Meilisearch — typo tolerance; production) or none.
LEIBNIZ_SEARCH_BACKEND=fts5
LEIBNIZ_INDEX_PATH=data/search.sqlite
# Meilisearch, when used: `docker compose up -d meilisearch` runs one locally.
# `leibniz index build` needs the master key (it writes); `leibniz serve` only
# needs a search key (MEILI_API_KEY, deploy/meili-search-key.sh) and falls
# back to MEILI_MASTER_KEY in development.
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
MEILI_API_KEY=
# Bind address, public origin (embedded in IIIF ids), worker processes.
LEIBNIZ_HOST=127.0.0.1
LEIBNIZ_PORT=8000
LEIBNIZ_BASE_URL=
LEIBNIZ_WORKERS=1
# Per-client rate limit on /api, /manifests, /annotations (requests/s, burst;
# 0 = off). On by default in `leibniz serve`; tests build the app without it.
LEIBNIZ_RATE_LIMIT=10
LEIBNIZ_RATE_BURST=40
