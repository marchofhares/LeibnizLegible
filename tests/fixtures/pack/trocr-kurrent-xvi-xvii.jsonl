{"line_id": "DE-611-HS-870001:0001:000", "text": "Mein Herr, ich habe dero schreiben", "conf": 0.79, "model": "dh-unibe/trocr-kurrent-XVI-XVII", "device": "cuda", "ms": 87.0}
