# /etc/meilisearch/env — EnvironmentFile of deploy/meilisearch.service.
# install.sh generates the master key; keep this file mode 0640 root:meilisearch.
MEILI_MASTER_KEY=
MEILI_ENV=production
MEILI_NO_ANALYTICS=true
MEILI_HTTP_ADDR=127.0.0.1:7700
MEILI_DB_PATH=/var/lib/meilisearch
# Indexing RAM ceiling; the default is two thirds of RAM, which is right for a
# box that runs nothing else. On an 8 GB VPS shared with the app, cap it:
MEILI_MAX_INDEXING_MEMORY=4GiB
# Meilisearch's own log: warnings only once the index is built.
MEILI_LOG_LEVEL=WARN
