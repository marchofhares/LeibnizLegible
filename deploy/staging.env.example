# /etc/leibniz-legible/staging.env — the staging site's configuration
# (EnvironmentFile of deploy/leibniz-legible-staging.service; deploy/README.md
# §14). deploy/env.example with four lines changed: the port, one worker,
# the staging origin, no rate limit. deploy/staging-install.sh installs it
# once and copies the store path, the search key and the image origin over
# from the live /etc/leibniz-legible/env; tests/test_deploy_staging.py holds
# the two examples to exactly these differences.

# The serving copy of the store, shared with the live site: both processes
# open it read-only. A branch that needs a new serving copy (M1) gets a
# second file on the box and this line pointed at it (deploy/README.md §14).
LEIBNIZ_DB_PATH=/var/lib/leibniz-legible/inventory.sqlite

# meili (typo tolerance; production) | fts5 (single file, no server) | none
LEIBNIZ_SEARCH_BACKEND=meili
# fts5 only:
LEIBNIZ_INDEX_PATH=/var/lib/leibniz-legible/search.sqlite

# Meilisearch. Use the restricted search key deploy/meili-search-key.sh
# creates, not the master key — the serving process never needs to write.
MEILI_URL=http://127.0.0.1:7700
MEILI_API_KEY=
# The index uid: the live index, read only, until a branch changes what the
# index holds (M1); then `deploy/staging.sh --index` builds
# leibniz_pages_staging beside it and writes that name here.
LEIBNIZ_MEILI_INDEX=leibniz_pages

# Bind to localhost; Caddy terminates TLS and proxies (deploy/Caddyfile).
LEIBNIZ_HOST=127.0.0.1
LEIBNIZ_PORT=8001

# The staging origin. Embedded in staging's manifest and annotation ids, which
# is why a staging link is never to be shared: its ids are not the real ones.
LEIBNIZ_BASE_URL=https://staging.leibnizlegible.com

# One worker beside the live site's two: the box has 4 GB and Meilisearch
# wants the page cache (deploy/README.md §14 says how to read what it uses).
LEIBNIZ_WORKERS=1

# No rate limit: the limit keeps crawlers off a public site, and here basic
# auth already turns them away; one reader behind a password needs none.
LEIBNIZ_RATE_LIMIT=0
LEIBNIZ_RATE_BURST=40

# Proxies whose X-Forwarded-For/Proto to trust (uvicorn). Caddy on the same
# host: 127.0.0.1. In the container stack, where only Caddy can reach the app: *
FORWARDED_ALLOW_IPS=127.0.0.1

# Page images. The public site serves its own mirror of the GWLB delivery
# scans (deploy/README.md §12): the image cache uploaded as it is, plus the
# thumbnails `leibniz images thumbs` derives, behind this origin. Leave unset
# to load images from the GWLB's endpoints instead.
LEIBNIZ_IMAGE_BASE_URL=https://images.leibnizlegible.com

# Calculemus, the game built on this corpus, runs on this host under its own
# subdomain and its own kit (deploy/README.md §13). Built as a switch, default
# off: unset, no link to the game anywhere; set, the About page shows one.
# LEIBNIZ_CALCULEMUS_URL=https://calculemus.leibnizlegible.com
